{
  "name": "vocabulary-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "import:ecdict": "tsx scripts/import/ecdict.ts",
    "import:tatoeba": "tsx scripts/import/tatoeba.ts",
    "import:llm-examples": "tsx scripts/import/llm-examples.ts",
    "llm:examples": "tsx scripts/llm/generate-examples.ts",
    "llm:check": "tsx scripts/llm/check-examples.ts",
    "import:stats": "tsx scripts/import/stats.ts",
    "import:wordnet": "tsx scripts/import/wordnet.ts",
    "import:similar": "tsx scripts/import/similar.ts",
    "import:family": "tsx scripts/import/family.ts",
    "import:all": "npm run import:ecdict && npm run import:wordnet && npm run import:similar && npm run import:family && npm run import:tatoeba && npm run import:llm-examples && npm run import:stats",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "better-auth": "^1.7.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "opencc-js": "^1.4.2",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
