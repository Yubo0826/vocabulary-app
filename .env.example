# 複製為 .env.local 後填入真實值（.env.local 不進版控）

# 本機開發：docker compose up -d 啟動的 Postgres
DATABASE_URL=postgres://vocab:vocab@localhost:5434/vocab

# npm test 使用的資料庫（測試會清空它，不要指向開發或正式資料庫）
TEST_DATABASE_URL=postgres://vocab:vocab@localhost:5434/vocab_test

# Better Auth：至少 32 字元的隨機字串，可用 `npx @better-auth/cli secret` 產生
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth（未設定時登入頁不顯示 Google 按鈕）
# Google Cloud Console → API 和服務 → 憑證 → 建立 OAuth 用戶端 ID（網頁應用程式）
# 已授權的重新導向 URI：http://localhost:3001/api/auth/callback/google（正式環境改成正式網域）
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- 正式環境（Railway）：在 Railway 服務的 Variables 設定，不放在這裡 ----
# DATABASE_URL=${{Postgres.DATABASE_URL}}   ← 參照同專案的 Postgres，走內網
# BETTER_AUTH_SECRET=                       ← 另外產生一組，不要和本機共用
# BETTER_AUTH_URL=https://正式網域
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   ← 重新導向 URI 加上 https://正式網域/api/auth/callback/google
# 部署時 railway.json 的 preDeployCommand 會先執行 npm run db:migrate

# ── LLM 例句（只在本機跑 npm run llm:examples 時需要，正式環境不用設）──
DEEPSEEK_API_KEY=

# Chrome 擴充元件的 Origin（逗號分隔，例如 chrome-extension://<商店給的 ID>）；載入未封裝項目的固定 ID 已寫在 src/lib/extension.ts，不用另外設定
# EXTENSION_ORIGINS=
